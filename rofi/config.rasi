configuration {
    font: "JetBrainsMono Nerd Font Bold 10";
    show-icons: true;
    icon-theme: "Fluent-dark";
    display-drun: "   ";
    drun-display-format: "{name}";
    disable-history: false;
    sidebar-mode: false;
}

* {
    bg-transparent:  rgba(0, 0, 0, 0);
    bg-modulo:       #282828;
    bg-input:        #3c3836; 
    bg-active:       #fe8019;
   
    fg-bright:       #fbf1c7; 
    fg-main:         #ebdbb2; 
    fg-dark:         #282828; 
    
    accent-green:    #8ec07c;
    border-color:    #504945; 

    background-color: transparent;
    text-color:       @fg-main;
}

window {
    transparency:       "real";
    background-color:   @bg-transparent; 
    border:             none;
    width:              650px;
    padding:            0px;
}

mainbox {
    background-color:   @bg-transparent;
    spacing:            12px;
    children:           [ inputbar, listview ];
}

inputbar {
    background-color:   @bg-input;
    border:             2px;
    border-color:       @border-color;
    padding:            8px 14px;
    spacing:            10px;
    children:           [ prompt, entry ];
}

prompt {
    background-color:   @bg-transparent;
    text-color:         @accent-green;
    vertical-align:     0.5;
}

entry {
    background-color:   @bg-transparent;
    placeholder:        "Buscar...";
    placeholder-color:  @border-color;
    text-color:         @fg-bright;
    vertical-align:     0.5;
}

listview {
    background-color:   @bg-transparent; 
    columns:            1;
    lines:              5;
    spacing:            10px; 
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    border:             none;
}

element {
    background-color:   @bg-modulo;
    text-color:         @fg-main;
    orientation:        horizontal;
    padding:            10px 14px;
    border:             2px;
    border-color:       @border-color; 
}

element normal.normal {
    background-color:   @bg-modulo;
    text-color:         @fg-main;
}

element selected.normal {
    background-color:   @bg-active; 
    text-color:         @fg-dark;
    border:             2px;
    border-color:       @border-color; 
}

element alternate.normal {
    background-color:   @bg-modulo;
    text-color:         @fg-main;
}

element-icon {
    background-color:   @bg-transparent;
    size:               20px;
    vertical-align:     0.5;
    margin-right:       12px;
}

element-text {
    background-color:   @bg-transparent;
    text-color:         inherit;
    vertical-align:     0.5;
}
